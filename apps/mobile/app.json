{
  "expo": {
    "name": "Glovebox",
    "slug": "glovebox",
    "owner": "adibonev",
    "scheme": "glovebox",
    "version": "1.0.6",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07100C",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "896086ca-35e4-4932-97b4-53e57c8c9da6"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bg.glovebox.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "TUVMJC4VMX",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.bg.glovebox.app"
        ]
      },
      "associatedDomains": [
        "applinks:www.glovebox.bg"
      ]
    },
    "android": {
      "package": "bg.glovebox.app",
      "backgroundColor": "#07100C",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07100C"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#07100C"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C4954C"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Glovebox ползва камерата, за да снимеш документа за технически преглед и данните да се попълнят сами. Снимката се разчита на телефона ти и не се качва никъде.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@bacons/apple-targets",
      "expo-localization",
      [
        "react-native-fbsdk-next",
        {
          "appID": "2164472027791072",
          "clientToken": "b707580ecc2ffdd3bb23c1a2a5f96272",
          "displayName": "Glovebox",
          "scheme": "fb2164472027791072",
          "isAutoInitEnabled": false,
          "autoLogAppEventsEnabled": false,
          "advertiserIDCollectionEnabled": false,
          "iosUserTrackingPermission": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Позволява да разберем коя реклама те е довела до Glovebox. Без имейл, документи или данни за колата."
        }
      ]
    ]
  }
}
