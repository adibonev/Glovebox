# Web app environment — copy to .env.local (git-ignored) and fill in.

# Supabase project (public-safe).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Reminder cron (/api/cron/send-reminders) — SERVER-ONLY, never expose to the browser ---
# Service-role key: bypasses RLS to process every User in the batch. Same value as
# packages/core/.env. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Resend API key (https://resend.com) for sending the reminder emails.
RESEND_API_KEY=
# Shared secret guarding the cron endpoint (Authorization: Bearer <CRON_SECRET> or ?secret=).
CRON_SECRET=
# Optional sender; defaults to "Glovebox <onboarding@resend.dev>" (Resend's no-domain test sender).
REMINDER_FROM=
# Optional test catch-all: when set, ALL reminder emails go here (Resend's no-domain mode only
# delivers to the account owner). Leave empty in production once a domain is verified.
REMINDER_TEST_TO=

# --- Stripe (billing) — SERVER-ONLY ---
# Test-mode secret key (sk_test_…).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) from the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_…) for the Pro plan, created in Stripe (2.99 €/mo and 24.99 €/yr).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
