# ─────────────────────────────────────────────────────────────────────────────
# Glovebox — environment variables (template)
#
# Copy the values you need into a local, git-ignored env file:
#   • apps/web    → apps/web/.env.local      (Next.js)
#   • apps/mobile → apps/mobile/.env.local   (Expo)
#
# NEVER commit real keys. All .env / .env.* files are git-ignored except this one.
# Supabase keys live in: Supabase Dashboard → Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase · Web (Next.js) ─────────────────────────────────────────────────
# Exposed to the browser via the NEXT_PUBLIC_ prefix. The anon key is safe to
# ship — Row Level Security enforces access. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Supabase · Mobile (Expo) ─────────────────────────────────────────────────
# Exposed to the app bundle via the EXPO_PUBLIC_ prefix. Same URL/anon key as web.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Supabase · Server-side / Edge Functions (SECRET) ─────────────────────────
# Bypasses RLS — trusted server contexts only (Edge Functions, cron, webhooks).
# MUST NOT carry a NEXT_PUBLIC_ / EXPO_PUBLIC_ prefix (would leak to clients).
# In the Supabase Edge runtime these are injected automatically; set locally only
# when running server code outside that runtime.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
